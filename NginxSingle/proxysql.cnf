admin_variables=
{
    admin_credentials="admin:admin;radmin:radmin"
    mysql_ifaces="0.0.0.0:6032"
}

mysql_variables=
{
    interfaces="0.0.0.0:3306"
    default_charset="utf8mb4"
}

mysql_servers =
(
    {
        address="db"
        port=3306
        hostgroup=1
        max_connections=200
    }
)

mysql_users =
(
    {
        username="root"
        password="root"
        default_hostgroup=1
        max_connections=200
        default_schema="loja"
        active=1
    }
)

mysql_query_rules =
(
    {
        rule_id=1
        active=1
        match_pattern="."
        destination_hostgroup=1
        apply=1
    }
)
