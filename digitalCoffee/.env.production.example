APP_NAME="Digital Coffee"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=troque-por-uma-senha-longa-e-unica
MYSQL_ROOT_PASSWORD=troque-por-outra-senha-longa-e-unica
MYSQL_INNODB_BUFFER_POOL_SIZE=512M
MYSQL_INNODB_REDO_LOG_CAPACITY=256M
MYSQL_MAX_CONNECTIONS=150

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_PASSWORD=troque-por-uma-senha-longa-e-unica

RABBITMQ_DEFAULT_USER=digitalcoffee
RABBITMQ_DEFAULT_PASS=troque-por-uma-senha-longa-e-unica
RABBITMQ_DEFAULT_VHOST=digitalcoffee
