# ProxySQL configuration file
admin_variables=
{
	admin_credentials="admin:admin"
	mysql_ifaces="0.0.0.0:6032"
	refresh_interval=2000
	debug=false
}

mysql_variables=
{
	interfaces="0.0.0.0:3306"
	threads=4
	max_connections=2000
	default_query_timeout=36000000
	connection_max_age_ms=3600000
	poll_timeout=2000
	wait_timeout=28800000
	mysql_monitor_enabled=true
	mysql_monitor_connect_interval=60000
	mysql_monitor_ping_interval=10000
	mysql_monitor_read_only_interval=1500
}

mysql_servers=
(
	{
		hostgroup_id=0
		hostname="db"
		port=3306
		weight=1000
		status="ONLINE"
		max_connections=1000
	}
)

mysql_users=
(
	{
		username="root"
		password="root"
		active=1
		use_ssl=0
		default_hostgroup=0
		default_schema="loja"
		max_connections=1000
	}
)

mysql_query_rules=
(
	{
		rule_id=1
		active=1
		match_pattern="^SELECT .* FOR UPDATE"
		destination_hostgroup=0
		apply=1
	},
	{
		rule_id=2
		active=1
		match_pattern="^SELECT"
		destination_hostgroup=0
		apply=1
	},
	{
		rule_id=3
		active=1
		match_pattern=".*"
		destination_hostgroup=0
		apply=1
	}
)

